# Database
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus

# S3 / MinIO storage for model checkpoints and datasets
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=
# ^ Public URL for presigned download links. Set this to MinIO's public domain
#   (e.g. https://minio.example.com) so external users can download checkpoints
#   directly from S3. If empty, downloads are proxied through the API server.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nexus

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# First admin org (created on startup if DB is empty)
SEED_ORG_NAME=nexus-admin
